{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rd Desktop",
  "mainBinaryName": "rd-desktop",
  "identifier": "dev.thijmen.rd.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app"],
    "category": "Utility",
    "shortDescription": "rd remote desktop",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
