{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rd Desktop",
  "mainBinaryName": "rd-desktop",
  "identifier": "dev.thijmen.rd.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "category": "Utility",
    "shortDescription": "rd remote desktop",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1MjVGQUFEMUNFNEE1QUQKUldTdHBlUWNyZm9sNVZsYWNCOGpsQkVlYTloM0VHSng2U0JscjNOM1F1MHRGZG5JZW9rRTRCVnkK",
      "endpoints": [
        "https://github.com/Thijmen/remoted/releases/download/updates/desktop.json"
      ],
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
