<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Fallback LaunchAgent, used when packaging/macos has no template at build time.
     `rd-agent install` replaces @PROGRAM@ (this executable) and @HOME@. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>dev.thijmen.rd.agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>@PROGRAM@</string>
		<string>run</string>
	</array>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>dev.thijmen.rd.agent</string>
	</array>
	<key>StandardOutPath</key>
	<string>@HOME@/Library/Logs/rd-agent/launchd.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/Library/Logs/rd-agent/launchd.log</string>
</dict>
</plist>
