---
// A screenshot in a browser window frame (or without one: `bare`, for crops of a dialog or a
// card). Images live in src/assets/screenshots/ (scripts/screenshots.mjs takes them) and are
// resized and converted at build time.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	src: ImageMetadata;
	alt: string;
	/** Shown in the address bar. */
	url?: string;
	caption?: string;
	bare?: boolean;
	/** Largest width on the page, e.g. "28rem" for a tall crop. */
	width?: string;
}

const { src, alt, url = 'rd.example.com', caption, bare = false, width } = Astro.props;
---

<figure class:list={['screenshot not-content', { bare }]} style={width ? `max-width: ${width}` : undefined}>
	<div class="window">
		{
			!bare && (
				<div class="bar" aria-hidden="true">
					<span class="lights">
						<i />
						<i />
						<i />
					</span>
					<span class="url">{url}</span>
				</div>
			)
		}
		<Image src={src} alt={alt} widths={[640, 960, 1440, src.width]} sizes="(min-width: 72rem) 45rem, 100vw" />
	</div>
	{caption && <figcaption set:html={caption} />}
</figure>

<style>
	.screenshot {
		margin: 1.75rem auto;
	}

	.bare .window {
		border-radius: 16px;
	}

	.window {
		overflow: hidden;
		border: 1px solid var(--rd-border);
		border-radius: 12px;
		background: #0b0d12;
		box-shadow: var(--rd-shadow);
	}

	.bar {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.45rem 0.7rem;
		border-bottom: 1px solid var(--rd-border);
		background: var(--rd-surface-2);
	}

	.lights {
		display: flex;
		gap: 0.3rem;
	}

	.lights i {
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 50%;
		background: var(--sl-color-gray-5);
	}

	.url {
		margin-inline: auto;
		padding: 0.1rem 0.8rem;
		border-radius: 999px;
		background: var(--sl-color-black);
		border: 1px solid var(--rd-border);
		color: var(--sl-color-gray-3);
		font-family: var(--__sl-font-mono);
		font-size: 0.7rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	img {
		display: block;
		width: 100%;
		height: auto;
	}

	figcaption {
		margin-top: 0.65rem;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		text-align: center;
	}
</style>
